{
  "name": "tanks",
  "private": true,
  "version": "5.0.0",
  "type": "module",
  "description": "2D Tanks game — TypeScript + Vite + Canvas",
  "license": "MIT",
  "author": "",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,css,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css,html}\"",
    "check": "npm run typecheck && npm run lint && npm run format:check",
    "clean": "rimraf dist node_modules/.vite node_modules/.tmp"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.5.0",
    "eslint": "^9.39.0",
    "eslint-plugin-import-x": "^4.3.0",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.0.1",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.5"
  }
}
